# Copy this file to .env and fill in your own values.
DISCORD_TOKEN=
# Optional: guild ID enables fast command sync to one test server.
DISCORD_GUILD_ID=
# Required for automatic posting; channel ID for #game-news.
GAME_NEWS_CHANNEL_ID=
# Optional role ID to ping for game news/free games. Leave empty to disable pings.
GAME_NEWS_ROLE_ID=
# Comma-separated Steam app IDs, e.g. 730,570. Leave empty to disable Steam news.
STEAM_APP_IDS=730
# Polling interval in minutes. Keep this reasonable; default is 30.
MEDIA_POLL_MINUTES=30
DATABASE_PATH=data/unector.sqlite3

# Optional password-protected publishing website (disabled by default).
WEB_PANEL_ENABLED=0
WEB_PANEL_HOST=127.0.0.1
WEB_PANEL_PORT=8787
WEB_PANEL_USER=publisher
# Use a unique password of at least 16 characters. Never commit your real .env.
WEB_PANEL_PASSWORD=replace-with-a-long-random-password
